# Скопируйте в .env и при необходимости измените значения: cp .env.example .env
# Секретов в репозитории нет. Реальные значения хранит только сервер.

# --- Сервер -----------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Публичный адрес сайта (используется в ссылках из писем, например для сброса пароля)
BASE_URL=http://localhost:3000

# --- Хранилища --------------------------------------------------------------
# Файл базы данных SQLite и каталог загрузок. Оба должны находиться ВНЕ папки public/.
DATABASE_PATH=data/ggkit.sqlite
UPLOAD_DIR=uploads
# Максимальный размер загружаемого документа, МБ (логотип организации — не более 1 МБ)
MAX_UPLOAD_MB=5

# --- Сессии и защита --------------------------------------------------------
SESSION_TTL_HOURS=168
# true — cookie сессии отправляются только по HTTPS. В production должно быть true.
COOKIE_SECURE=false
# true — только если сервер стоит за вашим обратным прокси (nginx/Caddy): тогда IP клиента берётся из X-Forwarded-For
TRUST_PROXY=false
# Стоимость хеширования паролей (scrypt N, степень двойки). 32768 — разумное значение по умолчанию.
SCRYPT_COST=32768

# --- Почта (восстановление пароля) -----------------------------------------
# none    — почта не настроена; письма НЕ отправляются, интерфейс честно сообщает об этом (по умолчанию)
# console — только для разработки: текст письма печатается в консоль сервера
# webhook — POST JSON {from,to,subject,text} на MAIL_WEBHOOK_URL (подходит для HTTP-API любого почтового сервиса)
MAIL_PROVIDER=none
MAIL_FROM=
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# --- Администратор (используется командой npm run create-admin) --------------
# ADMIN_EMAIL=admin@example.ru
# ADMIN_NAME=Администратор портала
# ADMIN_PASSWORD=   # если не задан — будет создан временный пароль с принудительной сменой при входе
